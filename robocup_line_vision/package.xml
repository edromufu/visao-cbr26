<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robocup_line_vision</name>
  <version>0.1.0</version>
  <description>Visão por estrutura de linhas (Schulz et al., Humanoids 2009) + detecção YOLO para a EDROM: fronteira do campo, esqueleto, nós, cruzamentos L/T/X com heading_rays, linhas e círculo central, fundidos com o detector.</description>
  <maintainer email="edromufu@gmail.com">EDROM</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>soccer_vision_2d_msgs</depend>
  <depend>soccer_vision_attribute_msgs</depend>

  <!-- opcionais: só se publish_landmarks:=true / cv_bridge não é usado (conversão com numpy) -->
  <exec_depend>edrom_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>soccer_ipm</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
