<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>object_finder</name>
  <version>0.1.0</version>
  <description>Visão da EDROM: detecção YOLO + estrutura de linhas (Schulz et al., Humanoids 2009): fronteira do campo, esqueleto, nós, cruzamentos L/T/X com heading_rays, linhas e círculo central, fundidos com o detector, e projeção ao chão própria.</description>
  <maintainer email="edromufu@gmail.com">EDROM</maintainer>
  <license>MIT</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>soccer_vision_2d_msgs</exec_depend>
  <exec_depend>soccer_vision_3d_msgs</exec_depend>
  <exec_depend>soccer_vision_attribute_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
