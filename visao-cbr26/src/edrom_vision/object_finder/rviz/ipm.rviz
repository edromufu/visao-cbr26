Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 0.5
      Plane Cell Count: 16
      Reference Frame: base_footprint
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/MarkerArray
      Name: Objetos IPM
      Enabled: true
      Topic:
        Value: /ipm/markers
    - Class: rviz_default_plugins/PointCloud2
      Name: Linhas IPM
      Enabled: true
      Topic:
        Value: /ipm/line_points
      Style: Flat Squares
      Size (m): 0.04
      Color Transformer: FlatColor
      Color: 255; 255; 255
  Global Options:
    Fixed Frame: base_footprint
    Background Color: 48; 48; 48
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.0
      Focal Point:
        X: 1.0
        Y: 0.0
        Z: 0.0
      Pitch: 0.9
      Yaw: 3.14
